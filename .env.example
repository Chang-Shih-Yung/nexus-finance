# ── 本地開發（沒有 DATABASE_URL 時使用）──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_finance
DB_USER=your_pg_user
DB_PASSWORD=your_pg_password

# ── 雲端（Neon）───────────────────────────────────────────────
# 若設定此項，上方 DB_* 變數將被忽略
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/nexus_finance?sslmode=require

# ── 伺服器 ────────────────────────────────────────────────────
PORT=3001

# ── Google AI Studio ──────────────────────────────────────────
# 免費取得：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── 身份驗證 ──────────────────────────────────────────────────
# JWT_SECRET 產生方式：openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# ── CORS（生產環境填入 Vercel 網址）──────────────────────────
# FRONTEND_URL=https://your-app.vercel.app
