# ── Supabase ──────────────────────────────────────────────────────
# 在 Supabase dashboard > Project Settings > API 取得
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Postgres-side secrets (Supabase Vault) ─────────────────────────
# This repo is RPC-first; there are no edge functions. The Groq API
# key used by nf_ai_ask lives in vault.secrets and is accessed from
# Postgres via vault.decrypted_secrets. Store / rotate with:
#
#   SELECT vault.create_secret('<your_key>', 'groq_api_key');
#   SELECT vault.update_secret('<secret_id>'::uuid, '<new_key>');
#
# Do NOT put the Groq key in this file or in any .env.
